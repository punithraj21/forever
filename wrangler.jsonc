{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forever",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "forever.devshark.site",
      "zone_name": "devshark.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "forever"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ielwyzeuupueysbjvlse.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0vast5HKJ1sZrqZcPLGUAw_sAd56C37"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
