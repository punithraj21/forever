{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forever",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "forever.devshark.site",
      "zone_name": "devshark.site",
      "custom_domain": true
    },
    {
      "pattern": "wedding.devshark.site",
      "zone_name": "devshark.site",
      "custom_domain": true
    },
    {
      "pattern": "pallavipunith.site",
      "zone_name": "pallavipunith.site",
      "custom_domain": true
    },
    {
      "pattern": "www.pallavipunith.site",
      "zone_name": "pallavipunith.site",
      "custom_domain": true
    }
  ],
  // Copy the prerendered pages into static assets for the static-assets
  // incremental cache (open-next.config.ts). `opennextjs-cloudflare deploy`
  // does this itself, a plain `wrangler deploy` doesn't — this makes either
  // work. Without it every request re-renders the page (error 1102).
  "build": {
    "command": "node -e \"const f=require('fs');f.existsSync('.open-next/cache')&&f.cpSync('.open-next/cache','.open-next/assets/cdn-cgi/_next_cache',{recursive:true})\""
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "forever"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ielwyzeuupueysbjvlse.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0vast5HKJ1sZrqZcPLGUAw_sAd56C37"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
